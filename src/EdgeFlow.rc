#include <windows.h>
#include "resource.h"

// 应用程序图标（文件资源管理器 / EXE 属性 / 托盘共用）
IDI_EDGEFLOW_APP ICON "..\\assets\\EdgeFlow.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "EdgeFlow"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "EdgeFlow"
            VALUE "OriginalFilename", "EdgeFlow.exe"
            VALUE "ProductName",      "EdgeFlow"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
